# Managed by Ansible (role lab_watchdog)
[Unit]
Description=Lab watchdog: watch the lab and wake it with Wake-on-LAN
Documentation=file:///usr/local/share/doc/lab-watchdog/README
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ lab_watchdog_user }}
Group={{ lab_watchdog_group }}
{% if lab_watchdog_telegram_enabled %}
EnvironmentFile={{ lab_watchdog_config_dir }}/secrets.env
{% endif %}
ExecStart={{ lab_watchdog_bin }} -c {{ lab_watchdog_config_dir }}/config.json run
{% if lab_watchdog_indicator_enabled %}
# GPIO for the local indicator: the gpio group owns /dev/gpiomem*, and only those devices are opened up.
# ExecStopPost is a safety net: if the process is killed, the buzzer and LEDs are left low.
SupplementaryGroups=gpio
ExecStopPost=-/usr/bin/pinctrl set {{ lab_watchdog_indicator_pin_buzzer }},{{ lab_watchdog_indicator_pin_green }},{{ lab_watchdog_indicator_pin_red }}{% if lab_watchdog_indicator_pin_ready | string | length > 0 %},{{ lab_watchdog_indicator_pin_ready }}{% endif %} op dl
{% endif %}
Restart=always
RestartSec=10
# The script pings systemd every cycle (30 s); if it stalls for 3 minutes systemd restarts it.
WatchdogSec=180
NotifyAccess=main
StateDirectory=lab-watchdog
StateDirectoryMode=0750
UMask=0027

# Sandboxing. CAP_NET_RAW only so that ping works; nothing else is needed.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
{% if lab_watchdog_indicator_enabled %}
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/gpiomem0 rw
DeviceAllow=/dev/gpiochip0 rw
{% else %}
PrivateDevices=yes
{% endif %}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
