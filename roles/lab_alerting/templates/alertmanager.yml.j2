# Gestionado por Ansible (rol lab_alerting). Telegram vía el bot de la secretaria.
global:
  resolve_timeout: 5m

templates:
  - /etc/prometheus/alertmanager_templates/*.tmpl

route:
  receiver: telegram
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    - matchers: [alertname="Watchdog"]
      receiver: telegram-heartbeat
      group_wait: 30s
      group_interval: 24h
      repeat_interval: 24h
    - matchers: [category="power"]
      receiver: telegram
      group_wait: 10s
      group_interval: 2m
      repeat_interval: 30m
    - matchers: [severity="critical"]
      receiver: telegram
      group_wait: 15s
      group_interval: 5m
      repeat_interval: 1h

receivers:
  - name: telegram-heartbeat
    telegram_configs:
      - bot_token_file: /etc/prometheus/telegram_bot_token
        chat_id: {{ lab_alerting_telegram_chat_id }}
        send_resolved: false
        disable_notifications: true
        message: '{% raw %}{{ template "telegram.heartbeat" . }}{% endraw %}'
  - name: telegram
    telegram_configs:
      - bot_token_file: /etc/prometheus/telegram_bot_token
        chat_id: {{ lab_alerting_telegram_chat_id }}
        send_resolved: true
        message: '{% raw %}{{ template "telegram.es" . }}{% endraw %}'
        disable_notifications: false

inhibit_rules:
  # Si el servidor está en SAI con batería baja, no repetir avisos menores de energía
  - source_matchers: [alertname="UPSLowBattery"]
    target_matchers: [alertname=~"UPSOnBattery|UPSInputVoltageAbnormal"]
    equal: []
