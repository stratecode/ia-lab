# Gestión de alertas técnicas vía el bot Watchdog; Donna recibe solo opt-in explícito.
global:
  resolve_timeout: 5m

templates:
  - /etc/prometheus/alertmanager_templates/*.tmpl

route:
  receiver: telegram-watchdog
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    - matchers: [notify_donna="true"]
      receiver: telegram-donna
      continue: true
{% if lab_watchdog_relay_enabled | default(false) | bool %}
    - matchers: [alertname="LabWatchdogEvento"]
      receiver: telegram-watchdog-relay
      group_by: [event_id]
      group_wait: 0s
      repeat_interval: 24h
{% endif %}
    - matchers: [alertname="Watchdog"]
      receiver: telegram-watchdog-heartbeat
      group_wait: 30s
      group_interval: 24h
      repeat_interval: 24h
    - matchers: [category="power"]
      receiver: telegram-watchdog
      group_wait: 10s
      group_interval: 2m
      repeat_interval: 30m
    - matchers: [severity="critical"]
      receiver: telegram-watchdog
      group_wait: 15s
      group_interval: 5m
      repeat_interval: 1h
    # Any technical alert without an explicit Donna opt-in still goes to Watchdog.
    - receiver: telegram-watchdog

receivers:
  - name: telegram-watchdog-heartbeat
    telegram_configs:
      - bot_token_file: {{ lab_alerting_watchdog_telegram_token_file }}
        chat_id: {{ lab_alerting_telegram_chat_id }}
        send_resolved: false
        disable_notifications: true
        message: '{% raw %}{{ template "telegram.heartbeat" . }}{% endraw %}'
  - name: telegram-donna
    telegram_configs:
      - bot_token_file: /etc/prometheus/telegram_bot_token
        chat_id: {{ lab_alerting_telegram_chat_id }}
        send_resolved: true
        message: '{% raw %}{{ template "telegram.donna-summary" . }}{% endraw %}'
        disable_notifications: false
  - name: telegram-watchdog
    telegram_configs:
      - bot_token_file: {{ lab_alerting_watchdog_telegram_token_file }}
        chat_id: {{ lab_alerting_telegram_chat_id }}
        send_resolved: true
        message: '{% raw %}{{ template "telegram.es" . }}{% endraw %}'
        disable_notifications: false
{% if lab_watchdog_relay_enabled | default(false) | bool %}
  - name: telegram-watchdog-relay
    telegram_configs:
      - bot_token_file: {{ lab_alerting_watchdog_telegram_token_file }}
        chat_id: {{ lab_alerting_telegram_chat_id }}
        send_resolved: false
        message: '{% raw %}{{ (index .Alerts 0).Annotations.description }}{% endraw %}'
{% endif %}

inhibit_rules:
  # Si el servidor está en SAI con batería baja, no repetir avisos menores de energía
  - source_matchers: [alertname="UPSLowBattery"]
    target_matchers: [alertname=~"UPSOnBattery|UPSInputVoltageAbnormal"]
    equal: []
